# Shell scripts and Git hooks run under bash, which a CR at the end of
# each line breaks, so they keep LF endings on Windows checkouts too.
*.sh text eol=lf
.githooks/* text eol=lf
# Linux package files (the /usr/bin launcher is a shell script without .sh).
packaging/linux/* text eol=lf
# Settings files exactly as ShareX wrote them (CRLF, no final newline).
crates/sharex-settings/tests/fixtures/** -text
# Tool outputs exactly as ShareX wrote them (compared byte for byte).
crates/sharex-tools/tests/fixtures/** -text
# ShareX's OCR outputs, zlib-compressed, compared bit for bit.
crates/sharex-ocr/tests/fixtures/** -text
# Test keys, certificates and ShareX's server logs, kept byte for byte
# (OpenSSH keys must stay LF).
crates/sharex-uploaders/tests/fixtures/sftp_test_* -text
crates/sharex-uploaders/tests/fixtures/*.p12 -text
crates/sharex-uploaders/tests/fixtures/servers.sharex.json -text

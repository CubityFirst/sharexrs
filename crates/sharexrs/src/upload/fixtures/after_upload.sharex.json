  "regex": [
    {
      "id": "default-force-https",
      "input": "http://i.example.com/abc.png",
      "pattern": "^https?://(.+)$",
      "replacement": "https://$1",
      "output": "https://i.example.com/abc.png"
    },
    {
      "id": "domain",
      "input": "https://i.example.com/abc.png",
      "pattern": "i\\.example\\.com",
      "replacement": "cdn.example.org",
      "output": "https://cdn.example.org/abc.png"
    },
    {
      "id": "no-match",
      "input": "https://i.example.com/abc.png",
      "pattern": "^ftp://(.+)$",
      "replacement": "x$1",
      "output": "https://i.example.com/abc.png"
    },
    {
      "id": "digits-after-group",
      "input": "abc",
      "pattern": "(b)",
      "replacement": "[$1a]",
      "output": "a[ba]c"
    },
    {
      "id": "group-out-of-range",
      "input": "abc",
      "pattern": "(b)",
      "replacement": "[$12]",
      "output": "a[$12]c"
    },
    {
      "id": "substitutions",
      "input": "abc",
      "pattern": "(?<n>b)",
      "replacement": "[${n}|$0|$&|$$|$`|$'|$+|$_]",
      "output": "a[b|b|b|$|a|c|b|abc]c"
    },
    {
      "id": "unknown-names",
      "input": "abc",
      "pattern": "(b)",
      "replacement": "[${x}|$x|${1}|$]",
      "output": "a[${x}|$x|b|$]c"
    },
    {
      "id": "named-numbered-after-unnamed",
      "input": "ab",
      "pattern": "(?<first>a)(b)",
      "replacement": "$1$2|${first}|$+",
      "output": "ba|a|a"
    },
    {
      "id": "empty-matches",
      "input": "abc",
      "pattern": "x*",
      "replacement": "-",
      "output": "-a-b-c-"
    },
    {
      "id": "all-matches",
      "input": "a-a-a",
      "pattern": "a",
      "replacement": "b",
      "output": "b-b-b"
    },
    {
      "id": "unicode",
      "input": "https://i.example.com/ünï/çödé.png",
      "pattern": "(ü\\w+)/(.)",
      "replacement": "$2/$1",
      "output": "https://i.example.com/ç/ünïödé.png"
    },
    {
      "id": "optional-group-missing",
      "input": "https://example.com",
      "pattern": "^(https?)://(www\\.)?(.+)$",
      "replacement": "$1|$2|$3",
      "output": "https||example.com"
    }
  ]
}

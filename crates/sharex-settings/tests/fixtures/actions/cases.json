{
  "parse": [
    { "pattern": "\"$input\"", "input": "C:\\a b\\x.png", "output": "C:\\a b\\x.jpg" },
    { "pattern": "%input %output", "input": "C:\\a b\\x.png", "output": "C:\\a b\\x.jpg" },
    { "pattern": "$input -o $output", "input": "C:\\a\\x.png", "output": "C:\\a\\x.jpg" },
    { "pattern": "$inputx %%input $$output %OUTPUT $Input", "input": "in", "output": "out" },
    { "pattern": "%output then %input", "input": "C:\\i.png", "output": null },
    { "pattern": "$input $output", "input": null, "output": "C:\\o.png" },
    { "pattern": "", "input": "C:\\i.png", "output": "C:\\o.png" },
    { "pattern": "%input%output", "input": "a", "output": "b" }
  ],
  "check_extension": [
    { "path": "a.png", "extensions": null },
    { "path": "a.png", "extensions": "" },
    { "path": "a.png", "extensions": "   " },
    { "path": "a.PNG", "extensions": "jpg png" },
    { "path": "a.png", "extensions": ".jpg,.png;" },
    { "path": "a.png", "extensions": "jpg" },
    { "path": "apng", "extensions": "png" },
    { "path": " ", "extensions": null },
    { "path": "", "extensions": "png" },
    { "path": "a.tar.gz", "extensions": "tar.gz" },
    { "path": "a.tar.gz", "extensions": "tar" },
    { "path": "a.mp4", "extensions": "jpg|png|mp4" },
    { "path": "a.webp", "extensions": "web p" },
    { "path": "a.JPEG", "extensions": "jpeg" },
    { "path": "x.ÄBC", "extensions": "äbc" },
    { "path": "a.png", "extensions": "*.png" },
    { "path": "a.p_g", "extensions": "p_g" },
    { "path": "C:\\dir.png\\file", "extensions": "png" }
  ],
  "json": [
    { "kind": "ExternalProgram", "value": null },
    { "kind": "ExternalProgram", "value": { "Name": "Paint", "Path": "C:\\Windows\\System32\\mspaint.exe" } },
    { "kind": "WatchFolderSettings", "value": null },
    { "kind": "WatchFolderSettings", "value": { "FolderPath": "C:\\in", "Filter": "*.png", "IncludeSubdirectories": true, "MoveFilesToScreenshotsFolder": true } }
  ],
  "runs": [
    { "name": "default-args", "program": {}, "files": ["shot.png"], "input": "<dir>\\shot.png" },
    { "name": "empty-args", "program": { "Args": "", "OutputExtension": "jpg" }, "files": ["shot.png"], "input": "<dir>\\shot.png" },
    { "name": "null-args", "program": { "Args": null }, "files": ["shot.png"], "input": "<dir>\\shot.png" },
    { "name": "copy-to-output", "program": { "Args": "copy %input %output", "OutputExtension": "jpg" }, "files": ["shot.png"], "input": "<dir>\\shot.png" },
    { "name": "copy-dot-extension", "program": { "Args": "copy \"$input\" \"$output\"", "OutputExtension": ".webp" }, "files": ["shot.png"], "input": "<dir>\\shot.png" },
    { "name": "output-not-made", "program": { "Args": "log $input $output", "OutputExtension": "jpg" }, "files": ["shot.png"], "input": "<dir>\\shot.png" },
    { "name": "blank-output-extension", "program": { "Args": "copy %input %output", "OutputExtension": "  " }, "files": ["shot.png"], "input": "<dir>\\shot.png" },
    { "name": "delete-input", "program": { "Args": "copy %input %output", "OutputExtension": "jpg", "DeleteInputFile": true }, "files": ["shot.png"], "input": "<dir>\\shot.png" },
    { "name": "delete-input-without-output", "program": { "Args": "log %input", "OutputExtension": "jpg", "DeleteInputFile": true }, "files": ["shot.png"], "input": "<dir>\\shot.png" },
    { "name": "delete-input-same-path", "program": { "Args": "append %output", "OutputExtension": "PNG", "DeleteInputFile": true }, "files": ["shot.png"], "input": "<dir>\\shot.png" },
    { "name": "edit-in-place", "program": { "Args": "append %input" }, "files": ["shot.png"], "input": "<dir>\\shot.png" },
    { "name": "filter-rejects", "program": { "Args": "touch %input.txt", "Extensions": "jpg mp4" }, "files": ["shot.png"], "input": "<dir>\\shot.png" },
    { "name": "filter-accepts", "program": { "Args": "log %input", "Extensions": ".PNG;gif" }, "files": ["shot.png"], "input": "<dir>\\shot.png" },
    { "name": "quoted-input", "program": { "Args": "log %input" }, "files": ["shot.png"], "input": "\"<dir>\\shot.png\"" },
    { "name": "missing-program", "program": { "Path": "<dir>\\nope.exe" }, "files": ["shot.png"], "input": "<dir>\\shot.png" },
    { "name": "no-program-path", "program": { "Path": null }, "files": ["shot.png"], "input": "<dir>\\shot.png" },
    { "name": "blank-input", "program": {}, "files": ["shot.png"], "input": "  " },
    { "name": "missing-input", "program": { "Args": "log %input %output", "OutputExtension": "jpg" }, "files": [], "input": "<dir>\\gone.png" },
    { "name": "environment-variable-path", "program": { "Path": "%SHAREXRS_ACTION_PROBE_DIR%\\<probename>", "Args": "log %input" }, "files": ["shot.png"], "input": "<dir>\\shot.png" },
    { "name": "tokens", "program": { "Args": "log %input $input %output $output $inputx %INPUT $$input", "OutputExtension": "txt" }, "files": ["shot.png"], "input": "<dir>\\shot.png" },
    { "name": "dotted-folder", "program": { "Args": "copy %input %output", "OutputExtension": "jpg" }, "files": ["my dir.v2\\shot.final.png"], "input": "<dir>\\my dir.v2\\shot.final.png" },
    { "name": "no-extension", "program": { "Args": "copy %input %output", "OutputExtension": "jpg" }, "files": ["noext"], "input": "<dir>\\noext" },
    { "name": "hidden-file-name", "program": { "Args": "copy %input %output", "OutputExtension": "bak" }, "files": [".hidden"], "input": "<dir>\\.hidden" },
    { "name": "forward-slashes", "program": { "Args": "copy %input %output", "OutputExtension": "jpg" }, "files": ["sub\\shot.png"], "input": "<dir>/sub/shot.png" },
    { "name": "hidden-window", "program": { "Args": "copy %input %output", "OutputExtension": "jpg", "HiddenWindow": true }, "files": ["shot.png"], "input": "<dir>\\shot.png" },
    { "name": "waits-for-exit", "program": { "Args": "sleep 300" }, "files": ["shot.png"], "input": "<dir>\\shot.png" },
    { "name": "raw-quotes-and-backslashes", "program": { "Args": "log \"a\\\" b\" \\\\\"c\\\\\" d\\e \"\" \"x\"\"y\"" }, "files": ["shot.png"], "input": "<dir>\\shot.png" },
    { "name": "input-is-a-folder", "program": { "Args": "log %input" }, "files": ["folder\\inner.png"], "input": "<dir>\\folder" },
    { "name": "unicode-path", "program": { "Args": "copy %input %output", "OutputExtension": "jpg" }, "files": ["ünï cødé\\shot ✓.png"], "input": "<dir>\\ünï cødé\\shot ✓.png" }
  ]
}

<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Headless reference for ShareXrs's command line: runs ShareX's own CLIManager
    (ShareX.HelpersLib.dll), the BinaryWriter message SingleInstanceManager sends,
    and JsonHelpers reading NativeMessagingInput (ShareX.dll), from a ShareX build
    of REFERENCE_COMMIT. No window opens. See README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ShareXBuild Condition="'$(ShareXBuild)' == ''">G:\scripts\sharexrs-ref\ShareX-build</ShareXBuild>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ShareX"><HintPath>$(ShareXBuild)\ShareX.dll</HintPath></Reference>
    <Reference Include="ShareX.HelpersLib"><HintPath>$(ShareXBuild)\ShareX.HelpersLib.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(ShareXBuild)\Newtonsoft.Json.dll</HintPath></Reference>
    <!-- Everything else ShareX's libraries load. -->
    <None Include="$(ShareXBuild)\*.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>

  "regex": [
    { "id": "default-force-https", "input": "http://i.example.com/abc.png", "pattern": "^https?://(.+)$", "replacement": "https://$1" },
    { "id": "domain", "input": "https://i.example.com/abc.png", "pattern": "i\\.example\\.com", "replacement": "cdn.example.org" },
    { "id": "no-match", "input": "https://i.example.com/abc.png", "pattern": "^ftp://(.+)$", "replacement": "x$1" },
    { "id": "digits-after-group", "input": "abc", "pattern": "(b)", "replacement": "[$1a]" },
    { "id": "group-out-of-range", "input": "abc", "pattern": "(b)", "replacement": "[$12]" },
    { "id": "substitutions", "input": "abc", "pattern": "(?<n>b)", "replacement": "[${n}|$0|$&|$$|$`|$'|$+|$_]" },
    { "id": "unknown-names", "input": "abc", "pattern": "(b)", "replacement": "[${x}|$x|${1}|$]" },
    { "id": "named-numbered-after-unnamed", "input": "ab", "pattern": "(?<first>a)(b)", "replacement": "$1$2|${first}|$+" },
    { "id": "empty-matches", "input": "abc", "pattern": "x*", "replacement": "-" },
    { "id": "all-matches", "input": "a-a-a", "pattern": "a", "replacement": "b" },
    { "id": "unicode", "input": "https://i.example.com/ünï/çödé.png", "pattern": "(ü\\w+)/(.)", "replacement": "$2/$1" },
    { "id": "optional-group-missing", "input": "https://example.com", "pattern": "^(https?)://(www\\.)?(.+)$", "replacement": "$1|$2|$3" }
  ]
}

<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Headless reference for ShareXrs's FFmpeg recorder: runs ShareX's own
    ShareX.ScreenCaptureLib.dll / ShareX.HelpersLib.dll (from a ShareX build of
    REFERENCE_COMMIT) over the cases in cases.json and writes the FFmpeg command
    lines ShareX would run, without running FFmpeg. See README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ShareXBuild Condition="'$(ShareXBuild)' == ''">G:\scripts\sharexrs-ref\ShareX-build</ShareXBuild>
  </PropertyGroup>
  <ItemGroup>
    <!-- 3.0 is the first Harmony that patches on CoreCLR 11 (2.4.x refuses). -->
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.6" />
    <Reference Include="ShareX.ScreenCaptureLib"><HintPath>$(ShareXBuild)\ShareX.ScreenCaptureLib.dll</HintPath></Reference>
    <Reference Include="ShareX.HelpersLib"><HintPath>$(ShareXBuild)\ShareX.HelpersLib.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(ShareXBuild)\Newtonsoft.Json.dll</HintPath></Reference>
    <!-- Everything else ShareX's libraries load. -->
    <None Include="$(ShareXBuild)\*.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>

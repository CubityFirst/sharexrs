[
  { "name": "default-preset", "input": "photo", "effects": [
    { "$type": "Canvas", "Margin": "0, 0, 0, 30" },
    { "$type": "DrawText", "Offset": "0, 0", "UseGradient": true } ] },

  { "name": "alpha-half", "input": "alpha", "effects": [ { "$type": "Alpha", "Value": 0.5 } ] },
  { "name": "alpha-add", "input": "alpha", "effects": [ { "$type": "Alpha", "Value": 1.2, "Addition": -0.1 } ] },
  { "name": "alpha-photo", "input": "photo", "effects": [ { "$type": "Alpha", "Value": 0.3, "Addition": 0.05 } ] },
  { "name": "blackwhite-photo", "input": "photo", "effects": [ { "$type": "BlackWhite" } ] },
  { "name": "blackwhite-alpha", "input": "alpha", "effects": [ { "$type": "BlackWhite" } ] },
  { "name": "brightness-up", "input": "photo", "effects": [ { "$type": "Brightness", "Value": 0.2 } ] },
  { "name": "brightness-down-alpha", "input": "alpha", "effects": [ { "$type": "Brightness", "Value": -0.3 } ] },
  { "name": "colorize-red", "input": "photo", "effects": [ { "$type": "Colorize", "Color": "Red", "Value": 0.5 } ] },
  { "name": "colorize-blue-alpha", "input": "alpha", "effects": [ { "$type": "Colorize", "Color": "0, 128, 255", "Value": 1.0 } ] },
  { "name": "contrast-up", "input": "photo", "effects": [ { "$type": "Contrast", "Value": 1.5 } ] },
  { "name": "contrast-down-alpha", "input": "alpha", "effects": [ { "$type": "Contrast", "Value": 0.6 } ] },
  { "name": "gamma-0.5", "input": "photo", "effects": [ { "$type": "Gamma", "Value": 0.5 } ] },
  { "name": "gamma-2.2-alpha", "input": "alpha", "effects": [ { "$type": "Gamma", "Value": 2.2 } ] },
  { "name": "gamma-clamped", "input": "tiny", "effects": [ { "$type": "Gamma", "Value": 9.0 } ] },
  { "name": "grayscale", "input": "photo", "effects": [ { "$type": "Grayscale" } ] },
  { "name": "grayscale-half-alpha", "input": "alpha", "effects": [ { "$type": "Grayscale", "Value": 0.5 } ] },
  { "name": "hue-90", "input": "photo", "effects": [ { "$type": "Hue", "Angle": 90 } ] },
  { "name": "hue-200-alpha", "input": "alpha", "effects": [ { "$type": "Hue", "Angle": 200 } ] },
  { "name": "inverse", "input": "photo", "effects": [ { "$type": "Inverse" } ] },
  { "name": "inverse-alpha", "input": "alpha", "effects": [ { "$type": "Inverse" } ] },
  { "name": "inverse-tiny", "input": "tiny", "effects": [ { "$type": "Inverse" } ] },
  { "name": "matrixcolor", "input": "alpha", "effects": [ { "$type": "MatrixColor", "Rr": 0.5, "Rg": 0.3, "Rb": 0.2, "Ro": 0.1, "Gg": 0.9, "Ga": 0.2, "Bb": 1.3, "Bo": -0.2, "Ar": 0.1, "Aa": 0.8, "Ao": 0.05 } ] },
  { "name": "polaroid", "input": "photo", "effects": [ { "$type": "Polaroid" } ] },
  { "name": "replacecolor-white", "input": "photo", "effects": [ { "$type": "ReplaceColor" } ] },
  { "name": "replacecolor-auto-threshold", "input": "photo", "effects": [ { "$type": "ReplaceColor", "AutoSourceColor": true, "TargetColor": "128, 0, 255, 0", "Threshold": 60 } ] },
  { "name": "replacecolor-alpha", "input": "alpha", "effects": [ { "$type": "ReplaceColor", "SourceColor": "0, 0, 0, 0", "TargetColor": "Magenta" } ] },
  { "name": "saturation-0", "input": "photo", "effects": [ { "$type": "Saturation", "Value": 0 } ] },
  { "name": "saturation-2.5-alpha", "input": "alpha", "effects": [ { "$type": "Saturation", "Value": 2.5 } ] },
  { "name": "selectivecolor", "input": "photo", "effects": [ { "$type": "SelectiveColor" } ] },
  { "name": "selectivecolor-4-alpha", "input": "alpha", "effects": [ { "$type": "SelectiveColor", "LightColor": "Red", "DarkColor": "0, 0, 128", "PaletteSize": 4 } ] },
  { "name": "sepia", "input": "photo", "effects": [ { "$type": "Sepia" } ] },
  { "name": "sepia-half-alpha", "input": "alpha", "effects": [ { "$type": "Sepia", "Value": 0.5 } ] },

  { "name": "blur-15", "input": "photo", "effects": [ { "$type": "Blur" } ] },
  { "name": "blur-4-alpha", "input": "alpha", "effects": [ { "$type": "Blur", "Radius": 4 } ] },
  { "name": "blur-tiny", "input": "tiny", "effects": [ { "$type": "Blur", "Radius": 5 } ] },
  { "name": "colordepth-4", "input": "photo", "effects": [ { "$type": "ColorDepth" } ] },
  { "name": "colordepth-1-alpha", "input": "alpha", "effects": [ { "$type": "ColorDepth", "BitsPerChannel": 1 } ] },
  { "name": "colordepth-7", "input": "photo", "effects": [ { "$type": "ColorDepth", "BitsPerChannel": 7 } ] },
  { "name": "convolution", "input": "photo", "effects": [ { "$type": "MatrixConvolution", "X0Y0": 1, "X1Y0": 2, "X2Y0": 1, "X1Y1": 4, "X0Y2": -1, "X2Y2": -2, "Factor": 3.0, "Offset": 20 } ] },
  { "name": "convolution-alpha", "input": "alpha", "effects": [ { "$type": "MatrixConvolution", "X1Y0": -1, "X0Y1": -1, "X1Y1": 5, "X2Y1": -1, "X1Y2": -1 } ] },
  { "name": "edgedetect", "input": "photo", "effects": [ { "$type": "EdgeDetect" } ] },
  { "name": "emboss-alpha", "input": "alpha", "effects": [ { "$type": "Emboss" } ] },
  { "name": "gaussianblur-15", "input": "photo", "effects": [ { "$type": "GaussianBlur" } ] },
  { "name": "gaussianblur-3-alpha", "input": "alpha", "effects": [ { "$type": "GaussianBlur", "Radius": 3 } ] },
  { "name": "glow", "input": "alpha", "effects": [ { "$type": "Glow" } ] },
  { "name": "glow-gradient-offset", "input": "alpha", "seed": 5, "effects": [ { "$type": "Glow", "Size": 8, "Strength": 1.5, "UseGradient": true, "Offset": "4, -3" } ] },
  { "name": "glow-photo", "input": "photo", "effects": [ { "$type": "Glow", "Size": 6, "Color": "255, 200, 0" } ] },
  { "name": "meanremoval", "input": "photo", "effects": [ { "$type": "MeanRemoval" } ] },
  { "name": "outline", "input": "alpha", "effects": [ { "$type": "Outline" } ] },
  { "name": "outline-only-padding", "input": "alpha", "effects": [ { "$type": "Outline", "Size": 3, "Padding": 2, "Color": "Red", "OutlineOnly": true } ] },
  { "name": "pixelate-10", "input": "photo", "effects": [ { "$type": "Pixelate" } ] },
  { "name": "pixelate-7-alpha", "input": "alpha", "effects": [ { "$type": "Pixelate", "Size": 7 } ] },
  { "name": "pixelate-border", "input": "photo", "effects": [ { "$type": "Pixelate", "Size": 12, "BorderSize": 2, "BorderColor": "200, 255, 0, 0" } ] },
  { "name": "reflection", "input": "photo", "effects": [ { "$type": "Reflection" } ] },
  { "name": "reflection-skew-alpha", "input": "alpha", "effects": [ { "$type": "Reflection", "Percentage": 40, "MaxAlpha": 200, "MinAlpha": 20, "Offset": 3, "Skew": true, "SkewSize": 10 } ] },
  { "name": "rgbsplit", "input": "photo", "effects": [ { "$type": "RGBSplit" } ] },
  { "name": "rgbsplit-alpha", "input": "alpha", "effects": [ { "$type": "RGBSplit", "OffsetRed": "3, 2", "OffsetGreen": "-2, 0", "OffsetBlue": "0, -4" } ] },
  { "name": "shadow", "input": "photo", "effects": [ { "$type": "Shadow" } ] },
  { "name": "shadow-alpha", "input": "alpha", "effects": [ { "$type": "Shadow", "Opacity": 0.8, "Size": 6, "Darkness": 0.5, "Color": "0, 0, 128", "Offset": "5, 4" } ] },
  { "name": "shadow-noresize", "input": "alpha", "effects": [ { "$type": "Shadow", "Size": 4, "Offset": "-3, 6", "AutoResize": false } ] },
  { "name": "sharpen", "input": "photo", "effects": [ { "$type": "Sharpen" } ] },
  { "name": "slice", "input": "photo", "seed": 42, "effects": [ { "$type": "Slice" } ] },
  { "name": "slice-small", "input": "alpha", "seed": 7, "effects": [ { "$type": "Slice", "MinSliceHeight": 3, "MaxSliceHeight": 12, "MinSliceShift": 2, "MaxSliceShift": 6 } ] },
  { "name": "smooth", "input": "photo", "effects": [ { "$type": "Smooth" } ] },
  { "name": "tornedge", "input": "photo", "seed": 3, "effects": [ { "$type": "TornEdge" } ] },
  { "name": "tornedge-straight", "input": "photo", "seed": 9, "effects": [ { "$type": "TornEdge", "Depth": 8, "Range": 12, "Sides": "Top, Right", "CurvedEdges": false } ] },
  { "name": "waveedge", "input": "photo", "effects": [ { "$type": "WaveEdge" } ] },
  { "name": "waveedge-sides", "input": "alpha", "effects": [ { "$type": "WaveEdge", "Depth": 6, "Range": 15, "Sides": "Bottom, Left" } ] },

  { "name": "autocrop-solid", "input": "crop-solid", "effects": [ { "$type": "AutoCrop" } ] },
  { "name": "autocrop-alpha-padding", "input": "crop-alpha", "effects": [ { "$type": "AutoCrop", "Padding": 4 } ] },
  { "name": "autocrop-sides", "input": "crop-solid", "effects": [ { "$type": "AutoCrop", "Sides": "Top, Left", "Padding": 2 } ] },
  { "name": "canvas", "input": "photo", "effects": [ { "$type": "Canvas", "Margin": "10, 5, 0, 20", "Color": "200, 30, 60" } ] },
  { "name": "canvas-percent-alpha", "input": "alpha", "effects": [ { "$type": "Canvas", "Margin": "10, 10, 10, 10", "MarginMode": "PercentageOfCanvas", "Color": "128, 0, 0, 255" } ] },
  { "name": "canvas-negative", "input": "photo", "effects": [ { "$type": "Canvas", "Margin": "-10, 0, -5, -8" } ] },
  { "name": "crop", "input": "photo", "effects": [ { "$type": "Crop", "Margin": "10, 5, 20, 8" } ] },
  { "name": "flip-h", "input": "alpha", "effects": [ { "$type": "Flip", "Horizontally": true } ] },
  { "name": "flip-v", "input": "photo", "effects": [ { "$type": "Flip", "Vertically": true } ] },
  { "name": "flip-both", "input": "tiny", "effects": [ { "$type": "Flip", "Horizontally": true, "Vertically": true } ] },
  { "name": "forceproportions-grow", "input": "photo", "effects": [ { "$type": "ForceProportions", "ProportionalWidth": 16, "ProportionalHeight": 9, "GrowFillColor": "White" } ] },
  { "name": "forceproportions-grow-tall", "input": "alpha", "effects": [ { "$type": "ForceProportions", "ProportionalWidth": 1, "ProportionalHeight": 2 } ] },
  { "name": "forceproportions-crop", "input": "photo", "effects": [ { "$type": "ForceProportions", "Method": "Crop" } ] },
  { "name": "resize-down", "input": "photo", "effects": [ { "$type": "Resize", "Width": 80 } ] },
  { "name": "resize-up-alpha", "input": "alpha", "effects": [ { "$type": "Resize", "Width": 0, "Height": 150 } ] },
  { "name": "resize-both", "input": "photo", "effects": [ { "$type": "Resize", "Width": 200, "Height": 60 } ] },
  { "name": "resize-ifbigger", "input": "photo", "effects": [ { "$type": "Resize", "Width": 300, "Mode": "ResizeIfBigger" } ] },
  { "name": "rotate-30", "input": "photo", "effects": [ { "$type": "Rotate", "Angle": 30 } ] },
  { "name": "rotate-30-clip", "input": "alpha", "effects": [ { "$type": "Rotate", "Angle": 30, "Upsize": false, "Clip": true } ] },
  { "name": "rotate-45-fit", "input": "photo", "effects": [ { "$type": "Rotate", "Angle": 45, "Upsize": false } ] },
  { "name": "rotate-90", "input": "alpha", "effects": [ { "$type": "Rotate", "Angle": 90 } ] },
  { "name": "rotate-minus-15", "input": "tiny", "effects": [ { "$type": "Rotate", "Angle": -15 } ] },
  { "name": "roundedcorners", "input": "photo", "effects": [ { "$type": "RoundedCorners" } ] },
  { "name": "roundedcorners-5-alpha", "input": "alpha", "effects": [ { "$type": "RoundedCorners", "CornerRadius": 5 } ] },
  { "name": "scale-50", "input": "photo", "effects": [ { "$type": "Scale", "WidthPercentage": 50 } ] },
  { "name": "scale-150-alpha", "input": "alpha", "effects": [ { "$type": "Scale", "WidthPercentage": 150, "HeightPercentage": 120 } ] },
  { "name": "skew-h", "input": "photo", "effects": [ { "$type": "Skew", "Horizontally": 10 } ] },
  { "name": "skew-v-alpha", "input": "alpha", "effects": [ { "$type": "Skew", "Vertically": -8 } ] },

  { "name": "background", "input": "alpha", "effects": [ { "$type": "DrawBackground", "Color": "30, 160, 90" } ] },
  { "name": "background-gradient", "input": "alpha", "effects": [ { "$type": "DrawBackground", "UseGradient": true } ] },
  { "name": "background-gradient-diag", "input": "tiny", "effects": [ { "$type": "DrawBackground", "UseGradient": true, "Gradient": { "Type": "BackwardDiagonal", "Colors": [ { "Color": "Yellow", "Location": 10.0 }, { "Color": "128, 0, 0, 255", "Location": 80.0 } ] } } ] },
  { "name": "backgroundimage", "input": "alpha", "effects": [ { "$type": "DrawBackgroundImage", "ImageFilePath": "{inputs}\\background.png" } ] },
  { "name": "backgroundimage-tile", "input": "alpha", "effects": [ { "$type": "DrawBackgroundImage", "ImageFilePath": "{inputs}\\background.png", "Tile": true } ] },
  { "name": "border", "input": "photo", "effects": [ { "$type": "DrawBorder", "Size": 3, "Color": "200, 40, 40" } ] },
  { "name": "border-inside-dash", "input": "alpha", "effects": [ { "$type": "DrawBorder", "Type": "Inside", "Size": 2, "DashStyle": "Dash", "Color": "Blue" } ] },
  { "name": "border-gradient", "input": "photo", "effects": [ { "$type": "DrawBorder", "Size": 6, "UseGradient": true } ] },
  { "name": "border-1", "input": "photo", "effects": [ { "$type": "DrawBorder" } ] },
  { "name": "checkerboard", "input": "alpha", "effects": [ { "$type": "DrawCheckerboard" } ] },
  { "name": "checkerboard-7", "input": "alpha", "effects": [ { "$type": "DrawCheckerboard", "Size": 7, "Color": "Red", "Color2": "0, 0, 128" } ] },
  { "name": "image", "input": "photo", "effects": [ { "$type": "DrawImage", "ImageLocation": "{inputs}\\watermark.png" } ] },
  { "name": "image-bottomright", "input": "photo", "effects": [ { "$type": "DrawImage", "ImageLocation": "{inputs}\\watermark.png", "Placement": "BottomRight", "Offset": "5, 5", "Opacity": 50 } ] },
  { "name": "image-scaled", "input": "alpha", "effects": [ { "$type": "DrawImage", "ImageLocation": "{inputs}\\watermark.png", "Placement": "MiddleCenter", "SizeMode": "PercentageOfWatermark", "Size": "150, 0" } ] },
  { "name": "image-tile", "input": "photo", "effects": [ { "$type": "DrawImage", "ImageLocation": "{inputs}\\watermark.png", "Placement": "MiddleCenter", "Tile": true } ] },
  { "name": "image-rotateflip", "input": "photo", "effects": [ { "$type": "DrawImage", "ImageLocation": "{inputs}\\watermark.png", "RotateFlip": "Rotate90FlipX", "CompositingMode": "SourceCopy" } ] },
  { "name": "particles", "input": "photo", "seed": 4, "effects": [ { "$type": "DrawParticles", "ImageFolder": "{inputs}\\particles", "ImageCount": 12 } ] },
  { "name": "particles-background", "input": "alpha", "seed": 8, "effects": [ { "$type": "DrawParticles", "ImageFolder": "{inputs}\\particles", "ImageCount": 6, "Background": true, "NoOverlap": true } ] },
  { "name": "text", "input": "photo", "effects": [ { "$type": "DrawText" } ] },
  { "name": "text-topleft", "input": "alpha", "effects": [ { "$type": "DrawText", "Text": "ShareX 1234", "Placement": "TopLeft", "TextFont": "Arial, 14pt, style=Bold", "DrawTextShadow": false, "CornerRadius": 0 } ] },
  { "name": "textex", "input": "photo", "effects": [ { "$type": "DrawTextEx" } ] },
  { "name": "textex-outline-shadow", "input": "photo", "seed": 2, "effects": [ { "$type": "DrawTextEx", "Text": "AVAWAy", "Placement": "MiddleCenter", "Font": "Arial, 28pt, style=Bold", "Outline": true, "OutlineSize": 3, "Shadow": true } ] },
  { "name": "textex-angle-gradient", "input": "alpha", "seed": 6, "effects": [ { "$type": "DrawTextEx", "Text": "Text", "Angle": 30, "UseGradient": true, "Font": "Arial, 24px" } ] },

  { "name": "chain", "input": "alpha", "seed": 12, "effects": [
    { "$type": "Resize", "Width": 90 },
    { "$type": "Saturation", "Value": 1.4 },
    { "$type": "Shadow", "Size": 5 },
    { "$type": "DrawBorder", "Size": 2, "Color": "Black" },
    { "$type": "Blur", "Enabled": false } ] }
]

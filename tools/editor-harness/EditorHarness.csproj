<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Renders image editor annotations with ShareX's own code (ShareX.ImageEditor.dll
    from a build of the reference commit) on Avalonia's headless platform, with
    Skia drawing and no window. See README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- The ShareX build to test: the reference commit's ShareX-build folder. -->
    <ShareXBuild Condition="'$(ShareXBuild)' == ''">G:\scripts\sharexrs-ref\ShareX-build</ShareXBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- The versions ShareX's Directory.Packages.props pins. -->
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.6" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ShareX.ImageEditor"><HintPath>$(ShareXBuild)\ShareX.ImageEditor.dll</HintPath></Reference>
    <Reference Include="ShareX.Avalonia"><HintPath>$(ShareXBuild)\ShareX.Avalonia.dll</HintPath></Reference>
    <Reference Include="ShareX.Icons"><HintPath>$(ShareXBuild)\ShareX.Icons.dll</HintPath></Reference>
  </ItemGroup>
</Project>

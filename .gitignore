/target
# Screenshots from scripts/winshot.ps1 and `sharexrs --render`, for comparing
# against ShareX; regenerate rather than commit.
/shots

# Python's bytecode caches (scripts/, tools/*-harness/).
__pycache__/
*.pyc

# Every .NET harness's build output (tools/<harness>/bin, obj, and nested
# projects such as tools/uploaders-harness/dotnet).
/tools/**/bin/
/tools/**/obj/

# Staging for the release packages (scripts/package-linux.sh).
/build

# The update harness regenerates its cases (make_cases.py; ~1 MB).
/tools/update-harness/cases.json
